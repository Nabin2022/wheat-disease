   "source": [
    "class_weights_arr = compute_class_weight(class_weight='balanced', classes=np.unique(train_labels), y=train_labels)\n",
    "class_weights = {i: w for i, w in enumerate(class_weights_arr)}\n",
    "class_weights\n"
